# Copy to .env and fill in values
HF_TOKEN=hf_your_token_here

# Gateway
GATEWAY_PORT=8000
GATEWAY_CONFIG=./configs/gateway.yaml
LOG_LEVEL=info

# vLLM backends
VLLM_BIG_PORT=8001
VLLM_SMALL_PORT=8002

# Model IDs (override if using pre-quantized checkpoints)
MODEL_BIG=neuralmagic/Qwen2.5-72B-Instruct-FP8
MODEL_SMALL=Qwen/Qwen2.5-7B-Instruct

# Observability
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
OTEL_COLLECTOR_PORT=4317
